using Gtk 4.0;

template $TrgToolbar: Box {
  orientation: horizontal;
  // The items are icon only, with the label as tooltip, like
  // GTK_TOOLBAR_BOTH_HORIZ showed them in GTK 3. The icons are symbolic at
  // the default 16px, as GNOME's HIG asks for in toolbars: monochrome, and
  // recolored with the theme (dark mode, insensitive buttons).
  styles [
    "toolbar",
  ]

  // GtkMenuToolButton: a button connecting to the current profile, with a
  // drop down of all the profiles next to it. While connected, the button
  // disconnects instead, see Toolbar::set_connected().
  Box {
    styles [
      "linked",
    ]

    Button connect_button {
      has-frame: false;
      tooltip-text: _("Connect");
      action-name: "win.connect";
      action-target: "-1";

      accessibility {
        label: _("Connect");
      }

      // A stack is as wide as its widest page, so the button keeps its width
      // (and the buttons after it their place) in both states, whichever
      // label is longer in the translation.
      Stack connect_stack {
        StackPage {
          name: "connect";

          child: Box {
            halign: center;
            spacing: 6;

            Image {
              icon-name: "trg-connect-symbolic";
            }

            Label {
              label: _("Connect");
            }
          };
        }

        StackPage {
          name: "disconnect";

          child: Box {
            halign: center;
            spacing: 6;

            Image {
              icon-name: "trg-disconnect-symbolic";
            }

            Label {
              label: _("Disconnect");
            }
          };
        }
      }
    }

    MenuButton connect_menu_button {
      has-frame: false;
      tooltip-text: _("Connection");

      accessibility {
        label: _("Connection");
      }
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Add");
    action-name: "win.add";

    accessibility {
      label: _("Add");
    }

    Image {
      icon-name: "list-add-symbolic";
    }
  }

  Separator {
    orientation: vertical;
    margin-start: 4;
    margin-end: 4;
  }

  Button {
    has-frame: false;
    tooltip-text: _("Resume");
    action-name: "win.resume";

    accessibility {
      label: _("Resume");
    }

    Image {
      icon-name: "media-playback-start-symbolic";
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Pause");
    action-name: "win.pause";

    accessibility {
      label: _("Pause");
    }

    Image {
      icon-name: "media-playback-pause-symbolic";
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Remove");
    action-name: "win.remove";

    accessibility {
      label: _("Remove");
    }

    Image {
      icon-name: "list-remove-symbolic";
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Remove and delete data");
    action-name: "win.delete";

    accessibility {
      label: _("Remove and delete data");
    }

    Image {
      icon-name: "user-trash-symbolic";
    }
  }
}
