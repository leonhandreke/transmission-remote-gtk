using Gtk 4.0;

template $TrgToolbar: Box {
  orientation: horizontal;
  // The buttons after the server picker are icon only, with the label as
  // tooltip, like
  // GTK_TOOLBAR_BOTH_HORIZ showed them in GTK 3. The icons are symbolic at
  // the default 16px, as GNOME's HIG asks for in toolbars: monochrome, and
  // recolored with the theme (dark mode, insensitive buttons).
  styles [
    "toolbar",
  ]

  // The server picker: the connection's status and profile, with a menu of
  // the profiles, see Toolbar::set_connection()
  MenuButton server_button {
    has-frame: false;
    always-show-arrow: true;
    menu-model: server_menu;

    child: Box {
      spacing: 6;

      Image status_icon {
        icon-name: "trg-status-disconnected-symbolic";
      }

      // Long names are cut, see Toolbar::set_connection()
      Label server_label {
        ellipsize: end;
        max-width-chars: 20;
      }
    };
  }

  Button {
    has-frame: false;
    tooltip-text: _("Add");
    action-name: "win.add";

    accessibility {
      label: _("Add");
    }

    Image {
      icon-name: "list-add-symbolic";
    }
  }

  Separator {
    orientation: vertical;
    margin-start: 4;
    margin-end: 4;
  }

  Button {
    has-frame: false;
    tooltip-text: _("Resume");
    action-name: "win.resume";

    accessibility {
      label: _("Resume");
    }

    Image {
      icon-name: "media-playback-start-symbolic";
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Pause");
    action-name: "win.pause";

    accessibility {
      label: _("Pause");
    }

    Image {
      icon-name: "media-playback-pause-symbolic";
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Remove");
    action-name: "win.remove";

    accessibility {
      label: _("Remove");
    }

    Image {
      icon-name: "list-remove-symbolic";
    }
  }

  Button {
    has-frame: false;
    tooltip-text: _("Remove and delete data");
    action-name: "win.delete";

    accessibility {
      label: _("Remove and delete data");
    }

    Image {
      icon-name: "user-trash-symbolic";
    }
  }
}

// The profiles are its first section, see Toolbar::new(). Connect and
// Disconnect are hidden along with their actions, so only one of them shows.
menu server_menu {
  section {
    item {
      label: _("Connect");
      action: "win.connect-current";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Disconnect");
      action: "win.disconnect";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Edit Profiles…");
      action: "win.edit-profiles";
    }
  }
}
