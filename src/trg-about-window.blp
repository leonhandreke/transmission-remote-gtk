using Gtk 4.0;
// The name, version and logo come from the build
AboutDialog about_dialog {
  destroy-with-parent: true;
  license-type: gpl_2_0;
  copyright: "(C) 2011-2013 Alan Fitton";
  comments: _("A remote client to transmission-daemon.");
  website: "https://github.com/transmission-remote-gtk/transmission-remote-gtk";
  website-label: "https://github.com/transmission-remote-gtk/transmission-remote-gtk";

  authors: [
    "Alan Fitton <alan@eth0.org.uk>",
  ];

  translator-credits: "translations kindly contributed by\n\n* Pierre Rudloff (French)\n* Julian Held (German)\n* Algimantas Margevičius (Lithuanian)\n* Youn sok Choi (Korean)\n* Piotr (Polish)\n* Y3AVD (Russian)\n* aspidzent (Spanish)\n* Åke Svensson (Swedish)\n* ROR191 (Ukranian)\n";
}
