using Gtk 4.0;

// TrgStatusBar lays these out itself: the labels ellipsize, and when there
// isn't room for all of them, the speeds keep their space longest, then the
// free space, and the connection status gets what's left.
template $TrgStatusBar: Widget {
  margin-start: 2;
  margin-end: 2;
  margin-top: 2;
  margin-bottom: 2;

  Label info_lbl {
    label: _("Disconnected");
    ellipsize: end;
    xalign: 0;
    has-tooltip: true;
    query-tooltip => $ellipsized_tooltip();
  }

  Label free_lbl {
    ellipsize: end;
    margin-start: 5;
    margin-end: 5;
    has-tooltip: true;
    query-tooltip => $ellipsized_tooltip();
  }

  Label speed_lbl {
    ellipsize: start;
    margin-start: 5;
    margin-end: 5;
    has-tooltip: true;
    query-tooltip => $ellipsized_tooltip();
  }

  Image turtle_image {
    visible: false;
    margin-start: 5;
    margin-end: 5;

    GestureClick {
      pressed => $turtle_toggle();
    }
  }
}
