using Gtk 4.0;
// The skeleton of the main window. Its parts that need the client or the
// models when they're created are added by TrgMainWindow: the toolbar, the
// state selector, the lists and the drop target.
template $TrgMainWindow: ApplicationWindow {
  title: _("Transmission Remote");
  // Fits a 1024x600 screen: GNOME's top bar leaves 568 px, and with
  // client-side decorations this includes the title bar
  default-width: 1000;
  default-height: 560;
  close-request => $close_request();
  destroy => $destroy_window();

  Box {
    orientation: vertical;
    // Not on macOS, which shows the menu in its menu bar
    PopoverMenuBar menu_bar {}

    Box toolbar_box {
      // Typing in the main window searches too, see construct()
      SearchEntry filter_entry {
        valign: center;
        placeholder-text: _("Filter torrents");
        // It gets the toolbar's spare room, up to this. Its minimum width
        // stays small: the toolbar already sets the window's minimum.
        max-width-chars: 25;
        search-changed => $entry_filter_changed_cb();
        search-started => $filter_search_started_cb();
        stop-search => $filter_stop_search_cb();
      }
    }

    Paned vpaned {
      orientation: vertical;
      vexpand: true;
      resize-start-child: true;
      // Smaller than its minimum, the torrent list would be squeezed with
      // GTK warnings when the details are hidden
      shrink-start-child: false;
      resize-end-child: false;
      shrink-end-child: false;

      start-child: Paned hpaned {
        orientation: horizontal;
        resize-start-child: false;
        shrink-start-child: false;
        resize-end-child: true;
        shrink-end-child: true;

        // The torrent list is its child
        end-child: Overlay torrent_overlay {
          // While not connected, instead of the empty list
          [overlay]
          Box not_connected {
            orientation: vertical;
            halign: center;
            valign: center;
            margin-start: 12;
            margin-end: 12;
            spacing: 12;

            Image {
              icon-name: "trg-disconnect-symbolic";
              pixel-size: 96;
              margin-bottom: 12;

              styles [
                "dim-label",
              ]
            }

            Label {
              label: _("Not Connected");
              wrap: true;
              justify: center;

              styles [
                "title-2",
              ]
            }

            Label {
              label: _("Connect to a Transmission server to see its torrents.");
              wrap: true;
              justify: center;
            }

            // Without a host to connect to, as on the first start, the
            // button opens the profiles instead, see update_not_connected()
            Stack not_connected_stack {
              hhomogeneous: false;
              margin-top: 12;

              StackPage {
                name: "connect";

                child: Button {
                  halign: center;
                  label: _("Connect");
                  action-name: "win.connect";
                  action-target: "-1";

                  styles [
                    "suggested-action",
                  ]
                };
              }

              StackPage {
                name: "edit";

                child: Button {
                  halign: center;
                  label: _("Edit Profiles…");
                  action-name: "win.edit-profiles";

                  styles [
                    "suggested-action",
                  ]
                };
              }
            }
          }

          // When nothing matches the filter text
          [overlay]
          Box no_results {
            orientation: vertical;
            halign: center;
            valign: center;
            margin-start: 12;
            margin-end: 12;
            spacing: 12;
            visible: false;
            can-target: false;

            Image {
              icon-name: "edit-find-symbolic";
              pixel-size: 96;
              margin-bottom: 12;

              styles [
                "dim-label",
              ]
            }

            Label {
              label: _("No Results");
              wrap: true;
              justify: center;

              styles [
                "title-2",
              ]
            }

            Label {
              label: _("Try a different search");
              wrap: true;
              justify: center;
            }
          }
        };
      };

      end-child: Notebook notebook {
        ScrolledWindow {
          $TrgGeneralPanel gen_details {}
        }

        [tab]
        Label {
          label: _("General");
        }
      };
    }

    $TrgStatusBar status_bar {
      margin-top: 2;
      margin-bottom: 2;
    }
  }
}

// The context menu of the torrent list is made of these, and the speed limit
// and priority menus of the torrents.
menu torrent_actions_menu {
  item {
    label: _("Properties");
    action: "win.properties";
    icon: "document-properties";
  }

  item {
    label: _("Copy Magnet Link");
    action: "win.copy-magnet";
    icon: "edit-copy";
  }

  item {
    label: _("Resume");
    action: "win.resume";
    icon: "media-playback-start";
  }

  item {
    label: _("Pause");
    action: "win.pause";
    icon: "media-playback-pause";
  }

  item {
    label: _("Verify");
    action: "win.verify";
    icon: "view-refresh";
  }

  item {
    label: _("Re-announce");
    action: "win.reannounce";
    icon: "network-server";
  }

  item {
    label: _("Move");
    action: "win.move";
    icon: "drive-harddisk";
  }

  item {
    label: _("Remove");
    action: "win.remove";
    icon: "list-remove";
  }

  item {
    label: _("Remove and delete data");
    action: "win.delete";
    icon: "edit-delete";
  }
}

// While the server has queues
menu torrent_queue_menu {
  item {
    label: _("Start Now");
    action: "win.start-now";
    icon: "media-playback-start";
  }

  item {
    label: _("Move Up Queue");
    action: "win.up-queue";
    icon: "go-up";
  }

  item {
    label: _("Move Down Queue");
    action: "win.down-queue";
    icon: "go-down";
  }

  item {
    label: _("Bottom Of Queue");
    action: "win.bottom-queue";
    icon: "go-bottom";
  }

  item {
    label: _("Top Of Queue");
    action: "win.top-queue";
    icon: "go-top";
  }
}
