    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 3;
    }
  }

  Label {
    label: _("Ratio");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 2;
      row: 3;
    }
  }

  Label gen_ratio_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 3;
      row: 3;
    }
  }

  Label {
    label: _("Uploaded");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 4;
      row: 3;
    }
  }

  Label gen_uploaded_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 5;
      row: 3;
    }
  }

  Label {
    label: _("Leechers");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 0;
      row: 4;
