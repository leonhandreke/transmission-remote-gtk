  Label gen_leechers_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 4;
    }
  }

  Label {
    label: _("Ratio limit");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 2;
      row: 4;
    }
  }

  Label gen_limit_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 3;
      row: 4;
    }
  }

  Label {
    label: _("Corrupted");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 4;
      row: 4;
    }
  }

  Label gen_corrupted_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 5;
      row: 4;
    }
  }

  Label {
    label: _("Status");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 0;
      row: 5;
    }
  }

  Label gen_status_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 5;
    }
  }

  Label {
    label: _("Priority");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 2;
      row: 5;
    }
  }

  Label gen_priority_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
