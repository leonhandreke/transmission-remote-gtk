  Label {
    label: _("Location");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 0;
      row: 6;
    }
  }

  Label gen_downloaddir_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 6;
      column-span: 6;
    }
