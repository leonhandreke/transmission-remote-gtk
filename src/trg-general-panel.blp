using Gtk 4.0;

template $TrgGeneralPanel: Grid {
  row-spacing: 6;
  column-spacing: 8;
  sensitive: false;

  Label {
    label: _("Name");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 0;
      row: 0;
    }
  }

  Label gen_name_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 0;
      column-span: 6;
    }
  }

  Label {
    label: _("Size");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 0;
      row: 1;
    }
  }

  Label gen_size_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 1;
    }
  }

  Label {
    label: _("Rate Down");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 2;
      row: 1;
    }
  }

  Label gen_down_rate_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 3;
      row: 1;
    }
  }

  Label {
    label: _("Completed");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 4;
      row: 1;
    }
  }

  Label gen_completed_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 5;
      row: 1;
    }
  }

  Label {
    label: _("ETA");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 0;
      row: 2;
    }
  }

  Label gen_eta_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 1;
      row: 2;
    }
  }

  Label {
    label: _("Rate Up");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 2;
      row: 2;
    }
  }

  Label gen_up_rate_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 3;
      row: 2;
    }
  }

  Label {
    label: _("Downloaded");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
      column: 4;
      row: 2;
    }
  }

  Label gen_downloaded_label {
    xalign: 0;
    yalign: 0;
    width-chars: 10;
    selectable: true;

    layout {
      column: 5;
      row: 2;
    }
  }

  Label {
    label: _("Seeders");
    xalign: 0;
    yalign: 0;
    width-chars: 10;

    styles [
      "heading",
    ]

    layout {
