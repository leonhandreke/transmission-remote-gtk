using Gtk 4.0;

// The torrent list, with "Not Connected" or "No Results" over it. The tree
// view is added by TrgTorrentList, once it has the client.
template $TrgTorrentList: Widget {
  Overlay overlay {
    // While not connected, instead of the empty list
    [overlay]
    Box not_connected {
      orientation: vertical;
      halign: center;
      valign: center;
      margin-start: 12;
      margin-end: 12;
      spacing: 12;

      Image {
        icon-name: "trg-disconnect-symbolic";
        pixel-size: 96;
        margin-bottom: 12;

        styles [
          "dim-label",
        ]
      }

      Label {
        label: _("Not Connected");
        wrap: true;
        justify: center;

        styles [
          "title-2",
        ]
      }

      Label {
        label: _("Connect to a Transmission server to see its torrents.");
        wrap: true;
        justify: center;
      }

      // Without a host to connect to, as on the first start, the button
      // opens the profiles instead, and while connecting there's a spinner
      // in its place, see set_connection()
      Stack not_connected_stack {
        hhomogeneous: false;
        margin-top: 12;

        StackPage {
          name: "connect";

          child: Button {
            halign: center;
            label: _("Connect");
            action-name: "win.connect";
            action-target: "-1";

            styles [
              "suggested-action",
            ]
          };
        }

        StackPage {
          name: "edit";

          child: Button {
            halign: center;
            label: _("Edit Profiles…");
            action-name: "win.edit-profiles";

            styles [
              "suggested-action",
            ]
          };
        }

        StackPage {
          name: "connecting";

          // see util::restart_spinner()
          child: Box connecting_box {
            halign: center;
            spacing: 6;

            Spinner {}

            Label connecting_label {
              ellipsize: end;
            }
          };
        }
      }
    }

    // When nothing matches the filter text
    [overlay]
    Box no_results {
      orientation: vertical;
      halign: center;
      valign: center;
      margin-start: 12;
      margin-end: 12;
      spacing: 12;
      visible: false;
      can-target: false;

      Image {
        icon-name: "edit-find-symbolic";
        pixel-size: 96;
        margin-bottom: 12;

        styles [
          "dim-label",
        ]
      }

      Label {
        label: _("No Results");
        wrap: true;
        justify: center;

        styles [
          "title-2",
        ]
      }

      Label {
        label: _("Try a different search");
        wrap: true;
        justify: center;
      }
    }
  }
}

// The search, which the main window shows in its toolbar. Typing in the main
// window searches too, see MainWindow::construct().
SearchEntry search_entry {
  valign: center;
  placeholder-text: _("Filter torrents");
  // It gets the toolbar's spare room, up to this. Its minimum width stays
  // small: the toolbar already sets the window's minimum.
  max-width-chars: 25;
}

// The context menu is made of these, and the speed limit and priority menus
// of the torrents, see torrent_menu.rs.
menu torrent_actions_menu {
  item {
    label: _("Properties");
    action: "win.properties";
    icon: "document-properties";
  }

  item {
    label: _("Copy Magnet Link");
    action: "win.copy-magnet";
    icon: "edit-copy";
  }

  item {
    label: _("Resume");
    action: "win.resume";
    icon: "media-playback-start";
  }

  item {
    label: _("Pause");
    action: "win.pause";
    icon: "media-playback-pause";
  }

  item {
    label: _("Verify");
    action: "win.verify";
    icon: "view-refresh";
  }

  item {
    label: _("Re-announce");
    action: "win.reannounce";
    icon: "network-server";
  }

  item {
    label: _("Move");
    action: "win.move";
    icon: "drive-harddisk";
  }

  item {
    label: _("Remove");
    action: "win.remove";
    icon: "list-remove";
  }

  item {
    label: _("Remove and delete data");
    action: "win.delete";
    icon: "edit-delete";
  }
}

// While the server has queues
menu torrent_queue_menu {
  item {
    label: _("Start Now");
    action: "win.start-now";
    icon: "media-playback-start";
  }

  item {
    label: _("Move Up Queue");
    action: "win.up-queue";
    icon: "go-up";
  }

  item {
    label: _("Move Down Queue");
    action: "win.down-queue";
    icon: "go-down";
  }

  item {
    label: _("Bottom Of Queue");
    action: "win.bottom-queue";
    icon: "go-bottom";
  }

  item {
    label: _("Top Of Queue");
    action: "win.top-queue";
    icon: "go-top";
  }
}
